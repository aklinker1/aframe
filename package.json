{
  "name": "@aklinker1/aframe",
  "description": "Simple wrapper around Vite for creating pre-rendered, client-side web apps with a backend.",
  "version": "2.0.5",
  "packageManager": "bun@1.3.5",
  "type": "module",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/aklinker1/aframe.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/client/server.d.mts",
      "aframe-dev": "./dist/client/dev.mjs",
      "default": "./dist/client/server.mjs"
    },
    "./app": {
      "types": "./dist/client/app.d.mts",
      "default": "./dist/client/app.mjs"
    }
  },
  "bin": "dist/aframe.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "check",
    "aframe": "bun --silent src/aframe.ts",
    "dev": "bun --env-file demo/.env --watch demo/server/main.ts",
    "build": "tsdown --dts src/index.ts src/client/*.ts src/aframe.ts",
    "build:demo": "NODE_ENV=production bun aframe build demo",
    "preview": "NODE_ENV=production bun --env-file demo/.env demo/.output/server/main.ts",
    "test": "bun test src",
    "release": "bun run scripts/release.ts",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@aklinker1/check": "^2.4.0",
    "oxlint": "^1.95.0",
    "prettier": "^3.5.2",
    "publint": "^0.3.6",
    "puppeteer": "^24.4.0",
    "tsdown": "^0.21.10",
    "typescript": "^5.0.0",
    "vite": "^6.1.1"
  },
  "peerDependencies": {
    "@types/bun": "^1.3.5",
    "vite": "*",
    "puppeteer": "*"
  },
  "peerDependenciesMeta": {
    "puppeteer": {
      "optional": true
    }
  }
}
